// Black Ridge Scope Desk — data model.
// Dev/default uses SQLite (zero-config, file-based). To run on managed
// Postgres, change `provider` below to "postgresql" and set DATABASE_URL
// to a Postgres connection string — the schema itself is portable.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("estimator") // estimator | admin
  createdAt    DateTime @default(now())

  claimsCreated Claim[] @relation("ClaimCreatedBy")
}

// ---------------------------------------------------------------------------
// Customers / properties / claims
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  properties Property[]
}

model Property {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String

  createdAt DateTime @default(now())
  claims    Claim[]
}

model Claim {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // The primary product decision, captured at the start of every order and
  // controlling intake questions, required uploads, calculations, report
  // language/sections, disclaimers, and the final PDF package downstream.
  reportType String @default("insurance") // insurance | retail

  insuranceCarrier String?
  claimNumber      String?
  policyNumber     String?
  dateOfLoss       DateTime?
  causeOfLoss      String?
  adjusterName     String?
  adjusterPhone    String?
  adjusterEmail    String?
  estimator        String?
  inspectionDate   DateTime?
  status           String    @default("open") // open | estimating | submitted | supplementing | closed

  whiteLabelProfileId String?
  whiteLabelProfile   WhiteLabelProfile? @relation(fields: [whiteLabelProfileId], references: [id])

  createdById String?
  createdBy   User?   @relation("ClaimCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files              UploadedFile[]
  measurementReports MeasurementReport[]
  measurement        Measurement?
  accessories        Accessory[]
  findings           InspectionFinding[]
  photos             Photo[]
  revisions          EstimateRevision[]
  codeReport         CodeReport?
  codeCitations      CodeCitation[]
  weatherEvents      WeatherEvent[]
  supplements        Supplement[]
  generatedDocuments GeneratedDocument[]
  qcChecklists       QCChecklist[]
  retailIntake       RetailIntake?
  order              Order?
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model UploadedFile {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  kind       String // measurement_report | carrier_estimate | photo | other
  filename   String
  storageKey String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())

  measurementReport MeasurementReport?
  photo             Photo?
}

// ---------------------------------------------------------------------------
// Measurement extraction
// ---------------------------------------------------------------------------

model MeasurementReport {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  sourceFileId String       @unique
  sourceFile   UploadedFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  parserType   String // gaf_quickmeasure | eagleview | roofr | generic_pdf | csv | xml | manual
  status       String // processing | extracted | needs_review | failed
  rawText      String? // extracted raw text/content, for audit
  extracted    String? // JSON blob: field -> {value, confidence}
  errorMessage String?

  createdAt DateTime @default(now())
}

model Measurement {
  id      String @id @default(cuid())
  claimId String @unique
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  // Core measurements
  roofAreaSqFt     Float?
  measuredSquares  Float?
  facets           Int?
  predominantPitch String?
  pitchAreasJson   String? // JSON array [{pitch:"6/12", areaSqFt: 849}, ...]

  eaves   Float?
  rakes   Float?
  ridges  Float?
  hips    Float?
  valleys Float?

  starterLength       Float?
  dripEdgeLength      Float?
  flashingLength      Float?
  stepFlashingLength  Float?
  apronFlashingLength Float?
  leakBarrierLength   Float?

  twoStoryAreaSqFt   Float?
  steepSlopeAreaSqFt Float?

  wastePercent Float? @default(12)

  // Field-level provenance: JSON map fieldName -> "extracted" | "manual" | "needs_review"
  fieldSourceJson    String?
  // Field-level original extracted values preserved even after manual override
  originalValuesJson String?

  membraneWidthFeet Float? @default(3) // ice & water / valley membrane roll width used in calcs

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Accessories / inspection / photos
// ---------------------------------------------------------------------------

model Accessory {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  type     String // pipe_jack | turtle_box_vent | ridge_vent | powered_vent | chimney | chimney_flashing |
  // chimney_cricket | skylight | satellite_dish | kickout_diverter | wall_flashing |
  // counterflashing | apron_flashing | exhaust_vent | gutter | downspout | detached_garage |
  // low_slope_roofing | decking_replacement | additional_layer | interior_damage | other
  label    String? // used when type = other
  quantity Float   @default(1)
  unit     String  @default("ea")
  notes    String?

  createdAt DateTime @default(now())
}

model InspectionFinding {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  category    String // slopes | flashings | ventilation | gutters | interior | structural | other
  location    String?
  damageType  String // hail | wind | mechanical | wear | improper_installation | interior_water | other
  description String
  notes       String?

  createdAt DateTime @default(now())
}

model Photo {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  fileId String       @unique
  file   UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  caption              String?
  damageClassification String? // hail | wind | mechanical | wear | improper_installation | interior_water | other

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Price list
// ---------------------------------------------------------------------------

model PriceListItem {
  id                         String  @id @default(cuid())
  category                   String
  code                       String // stable key used by the calc engine, e.g. "tear_off_laminated" — unique per state, see @@unique below
  description                String
  unit                       String
  defaultUnitPrice           Float
  taxable                    Boolean @default(true)
  defaultDepreciationPercent Float   @default(0)
  codeCitation               String?
  calcRule                   String? // key into the calc-rule registry, e.g. "removal_squares"
  sortOrder                  Int     @default(0)
  active                     Boolean @default(true)

  // Regional assembly scoping. Null = universal/fallback item usable for any
  // state. A state-specific row (matched by `code` + `state`) is preferred
  // over the universal row of the same `code` when building an estimate for
  // a property in that state — see resolvePriceListForState().
  state String?

  // Report-type-specific pricing. Null falls back to defaultUnitPrice.
  // Keeps customer-facing unit price, insurance estimate price, and retail
  // proposal price as distinct, independently editable figures.
  insuranceUnitPrice Float?
  retailUnitPrice    Float?
  // Admin-only internal job cost — never rendered into any customer-facing PDF.
  internalCostPrice  Float?

  // Product-selection-engine metadata (used by the "why these materials were
  // selected" report section). All optional — legacy/simple price-list rows
  // keep working without them.
  manufacturer       String?
  productName        String?
  technicalFunction  String?
  // legally_required_code | required_by_manufacturer | required_for_warranty |
  // system_compatibility | recommended_climate_performance | optional_upgrade | company_standard
  reasonSelected     String?
  compatibleSystems  String?
  applicablePitches  String?
  climateSuitability String?
  codeRelevance      String?
  installReference   String?
  warrantyRelevance  String?
  dataSheetUrl       String?
  infoVerifiedDate   DateTime?
  standardOrUpgrade  String    @default("standard") // standard | upgrade
  // Which retail tier(s) this item belongs to when reportType=retail, e.g.
  // "good,better,best". Null = included in every tier (base scope).
  retailTierKeys     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, state])
}

// ---------------------------------------------------------------------------
// Estimate revisions / line items
// ---------------------------------------------------------------------------

model EstimateRevision {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  revisionNumber Int
  label          String?
  status         String  @default("draft") // draft | final

  wastePercent               Float @default(12)
  taxRatePercent             Float @default(8.5)
  defaultDepreciationPercent Float @default(0)
  deductible                 Float @default(0)
  priorPayments              Float @default(0)

  // Overhead & profit — never rendered into a customer-facing PDF unless an
  // administrator explicitly enables it for this revision.
  overheadProfitPercent           Float   @default(0)
  showOverheadProfitOnCustomerPdf Boolean @default(false)

  // Company policy guidance for what counts as steep-slope, shown in the
  // report's pitch explanation. Editable per revision (so it can vary by
  // insurer/market/company policy) rather than a single hardcoded rule.
  steepSlopePitchThreshold String @default("7/12")

  roundingMode String @default("nearest_cent") // nearest_cent | nearest_dollar

  // Retail-only: which tier this revision represents (good/better/best, or
  // whatever the admin has renamed the tiers to). Null for insurance revisions.
  retailTierKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems EstimateLineItem[]

  @@unique([claimId, revisionNumber])
}

model EstimateLineItem {
  id         String           @id @default(cuid())
  revisionId String
  revision   EstimateRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  category           String
  description        String
  unit               String
  quantity           Float
  calculatedQuantity Float? // original system-calculated quantity, preserved when overridden
  quantityOverridden Boolean @default(false)

  unitPrice             Float
  taxable               Boolean @default(true)
  taxableMaterialAmount Float   @default(0)
  taxRatePercent        Float   @default(0)
  taxAmount             Float   @default(0)

  rcv          Float  @default(0)
  // Pre-rounding RCV, preserved for audit even though rcv above is the
  // rounded value used everywhere else.
  rcvUnrounded Float?

  depreciationPercent Float @default(0)
  depreciationAmount  Float @default(0)
  acv                 Float @default(0)

  // Cost-component breakdown (optional; not all price-list items are broken
  // out this finely). Sum need not equal the line total exactly if unset.
  laborComponent     Float?
  materialComponent  Float?
  equipmentComponent Float?

  notes        String?
  codeCitation String?
  included     Boolean @default(true)
  sortOrder    Int     @default(0)

  priceListItemCode String?

  // Retail-only: which tier(s) this line belongs to, and whether it's an
  // optional upgrade the customer can toggle. Mirrors PriceListItem's
  // retailTierKeys/standardOrUpgrade at the moment the line was generated.
  retailTierKeys String?
  isUpgrade      Boolean @default(false)

  manualOverride   Boolean @default(false)
  overrideReason   String?
  reviewedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Code enforcement report
// ---------------------------------------------------------------------------

model CodeReport {
  id      String @id @default(cuid())
  claimId String @unique
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  authorityHavingJurisdiction String?
  departmentContact           String?
  adoptedCodeEdition          String?
  localAmendments             String?
  permitRequirements          String?
  permitFees                  String?
  iceBarrierRequirement       String?
  dripEdgeRequirement         String?
  valleyLiningRequirement     String?
  underlaymentRequirement     String?
  ventilationRequirement      String?
  chimneyCricketRequirement   String?
  reRoofLayerLimitation       String?
  deckingRequirement          String?

  sourceUrl        String?
  verified         Boolean   @default(false)
  verificationDate DateTime?
  notes            String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Weather
// ---------------------------------------------------------------------------

model WeatherEvent {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  eventDate                 DateTime
  eventType                 String // hail | wind | tornado | thunderstorm | other
  hailSizeInches            Float?
  windSpeedMph              Float?
  distanceFromPropertyMiles Float?

  // one of: area_reported | radar_indicated | verified_report_at_coordinate | confirmed_property_damage
  evidenceLevel String

  source          String // e.g. "NOAA NCEI Storm Events Database", "NWS Local Storm Report"
  sourceUrl       String?
  confidenceLevel String // low | medium | high
  notes           String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Supplement comparison
// ---------------------------------------------------------------------------

model Supplement {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  revisionId String?
  label      String
  status     String  @default("draft") // draft | submitted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carrierItems CarrierEstimateItem[]
  matches      SupplementMatch[]
}

model CarrierEstimateItem {
  id           String     @id @default(cuid())
  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  description String
  quantity    Float
  unit        String
  unitPrice   Float

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  matches SupplementMatch[]
}

// Links a contractor line item (by id, stored as plain string reference since
// it may point at any revision's line item) to a carrier item for comparison.
model SupplementMatch {
  id           String     @id @default(cuid())
  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  contractorLineItemId  String?
  contractorDescription String
  contractorQuantity    Float
  contractorUnit        String
  contractorUnitPrice   Float

  carrierItemId String?
  carrierItem   CarrierEstimateItem? @relation(fields: [carrierItemId], references: [id])

  reasonForSupplement   String?
  supportingCodeOrPhoto String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Generated documents
// ---------------------------------------------------------------------------

model GeneratedDocument {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  type        String // insurance_estimate | measurement_summary | code_report | weather_report |
  // supplement_request | homeowner_proposal | material_order | invoice
  revisionId  String?
  storageKey  String
  filename    String
  generatedAt DateTime @default(now())

  // Report-assembly configuration used to produce this revision of the
  // document (which optional sections were included), stored for audit.
  sectionConfigJson String?

  // Secure customer delivery — a signed, expiring link generated from the
  // internal tool once QC passes. No separate customer login is required.
  secureTokenHash      String?   @unique
  secureTokenExpiresAt DateTime?
  deliveredAt          DateTime?
  deliveredToEmail     String?
}

// ---------------------------------------------------------------------------
// Orders / payment
// ---------------------------------------------------------------------------

// A customer-facing order captured before any staff/admin work begins. The
// customer chooses a report purpose, submits contact + property details and
// report-type-specific intake answers, and pays via Stripe Checkout. Once
// payment is confirmed (via webhook), the order is converted into a
// Customer/Property/Claim for staff to work.
model Order {
  id String @id @default(cuid())

  reportType String // insurance | retail

  contactName  String
  contactEmail String
  contactPhone String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String

  // Report-type-specific intake answers (JSON — shape depends on reportType,
  // see src/lib/orderIntake.ts for the schema of each).
  intakeJson String?

  amountCents Int
  currency    String @default("usd")

  status String @default("pending_payment") // pending_payment | paid | canceled | expired

  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?

  claimId String? @unique
  claim   Claim?  @relation(fields: [claimId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Jurisdiction / code citations (structured sourcing)
// ---------------------------------------------------------------------------

// One row per code/jurisdiction requirement the report relies on, each
// individually sourced. Complements CodeReport's free-text summary fields
// with the exact-source/date/reviewer/status structure the report requires.
model CodeCitation {
  id      String @id @default(cuid())
  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  // ice_barrier | drip_edge | valley_lining | underlayment | ventilation |
  // layer_limitation | decking | fire_classification | wind | energy_code |
  // permit | sales_tax | permit_fee | other
  requirementKey  String
  requirementText String?

  sourceName  String?
  sourceUrl   String?
  codeSection String?

  verificationStatus String    @default("verification_required") // verified | verification_required
  verifiedDate       DateTime?
  reviewedByUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Retail bid workflow
// ---------------------------------------------------------------------------

// Admin-configurable, renamable retail tiers (default: Good / Better / Best).
model RetailTier {
  id          String  @id @default(cuid())
  key         String  @unique // stable key, e.g. "good" | "better" | "best"
  label       String // admin-editable display name
  description String?
  position    Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RetailIntake {
  id      String @id @default(cuid())
  claimId String @unique
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  desiredSystem         String?
  desiredManufacturer   String?
  shingleStyleColor     String?
  warrantySelection     String?
  ventilationPreference String?
  upgradesJson          String? // JSON array of selected upgrade price-list codes
  financingInterest     Boolean @default(false)
  requestedTimeframe    String?
  knownLeaksConcerns    String?
  existingRoofInfo      String?
  budgetRangeMin        Float?
  budgetRangeMax        Float?

  selectedTierKey String? // references RetailTier.key

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Quality control
// ---------------------------------------------------------------------------

model QCChecklist {
  id         String  @id @default(cuid())
  claimId    String
  claim      Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  revisionId String?

  // JSON map of checklist-item-key -> boolean. See src/lib/qc.ts for the
  // canonical list of required items.
  itemsJson String

  status String @default("incomplete") // incomplete | complete | exception_approved

  exceptionReason   String?
  exceptionByUserId String?

  completedByUserId String?
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// White-label branding
// ---------------------------------------------------------------------------

model WhiteLabelProfile {
  id   String @id @default(cuid())
  name String // internal label, e.g. "Acme Roofing (reseller)"

  businessName            String
  addressLine1            String?
  city                    String?
  state                   String?
  zip                     String?
  phone                   String?
  email                   String?
  website                 String?
  licenseNumber           String?
  salesRepName            String?
  workmanshipWarrantyText String?

  logoStorageKey    String?
  brandPrimaryColor String? // hex
  brandAccentColor  String? // hex

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims Claim[]
}
